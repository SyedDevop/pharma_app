{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tauri": {
      "type": "local",
      "enabled": true,
      "command": ["bunx", "-y", "@hypothesi/tauri-mcp-server"]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
